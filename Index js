// ============================================
// START BOTH BOTS
// ============================================

console.log('🎧 Starting Silent DJ Bot...');

// Start Telegram bot
TELEGRAM_BOT.launch()
    .then(() => console.log('✅ Telegram bot is running'))
    .catch(err => console.error('❌ Telegram error:', err));

// Start WhatsApp bot
startWhatsApp()
    .then(() => console.log('✅ WhatsApp bot is running'))
    .catch(err => console.error('❌ WhatsApp error:', err));

// Graceful shutdown
process.on('SIGINT', () => {
    TELEGRAM_BOT.stop('SIGINT');
    process.exit(0);
});

// ============================================
// SILENT DJ BOT — Telegram + WhatsApp
// ============================================

const { Telegraf } = require('telegraf');
const { makeWASocket, useMultiFileAuthState } = require('@whiskeysockets/baileys');
const fs = require('fs');

// ============================================
// CONFIGURATION
// ============================================
const TELEGRAM_TOKEN = 'YOUR_TELEGRAM_BOT_TOKEN'; // From @BotFather
const TELEGRAM_BOT = new Telegraf(TELEGRAM_TOKEN);

// Store pairing codes (in memory — use database for production)
const pairings = {};

// ============================================
// TELEGRAM BOT — Gives Pairing Codes
// ============================================

// Start command
TELEGRAM_BOT.start(async (ctx) => {
    const userId = ctx.from.id;
    const code = Math.floor(100000 + Math.random() * 900000); // 6-digit code
    
    pairings[code] = {
        telegramId: userId,
        username: ctx.from.username || 'unknown',
        createdAt: Date.now()
    };
    
    await ctx.reply(`
🎧 *Silent DJ Bot Pairing*

Your pairing code: *${code}*

📌 *How to pair:*
1. Open WhatsApp
2. Go to Settings → Linked Devices
3. Tap "Link a Device"
4. Enter this code: ${code}

⚠️ This code expires in 5 minutes.
    `, { parse_mode: 'Markdown' });
    
    // Auto-expire after 5 minutes
    setTimeout(() => {
        if (pairings[code]) {
            delete pairings[code];
        }
    }, 300000); // 5 minutes
});

// ============================================
// WHATSAPP BOT — Waits for pairing
// ============================================


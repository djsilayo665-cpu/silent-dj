# .npmrc - Force npm to use HTTPS instead of SSH for GitHub
git config url."https://github.com/".insteadOf git@github.com:
git config url."https://".insteadOf ssh://git@github.com/
git config url."https://github.com/".insteadOf ssh://git@github.com

# Allow npm to run git commands
git = true

# Use HTTPS for registry
registry=https://registry.npmjs.org/

# Disable strict SSL if needed (uncomment if you have SSL issues)
# strict-ssl=false

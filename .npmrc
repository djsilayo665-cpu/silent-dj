# .npmrc - NPM Configuration

# Convert SSH to HTTPS for GitHub (fixes Git SSH errors)
git config url."https://github.com/".insteadOf git@github.com:
git config url."https://".insteadOf git://

# Use HTTPS for all Git operations
git config --global url."https://github.com/".insteadOf ssh://git@github.com/

# Disable strict SSL for GitHub (optional, helps with some corporate networks)
# strict-ssl=false

# Use the default registry
registry=https://registry.npmjs.org/

# Always use HTTPS for registry
# legacy-peer-deps=true  # Uncomment if you have peer dependency issues

# Increase timeout for slow networks
timeout=60000

# Log level (useful for debugging)
loglevel=notice

# Cache settings
cache=~/.npm
